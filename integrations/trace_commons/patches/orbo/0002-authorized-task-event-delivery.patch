+#[tokio::test]
+async fn orbo_task_evidence_prepared_events_survive_authorized_delivery() {
+    let temp = tempfile::tempdir().unwrap();
+    let state = test_state(temp.path().to_path_buf());
+    let mut envelope = sample_envelope().await;
+    envelope.events = serde_json::from_slice(include_bytes!(concat!(
+        env!("CARGO_MANIFEST_DIR"),
+        "/fixtures/orbo-prepared-events.json"
+    )))
+    .unwrap();
+    envelope.consent.scopes = vec![ConsentScope::DebuggingEvaluation];
+    envelope.trace_card.allowed_uses = vec![TraceAllowedUse::Evaluation];
+    let submission = envelope.submission_id;
+    let expected = serde_json::to_value(&envelope.events).unwrap();
+    let _ = test_submit(state.clone(), "token-a", envelope)
+        .await
+        .unwrap();
+    let _ = review_decision_handler(
+        State(state.clone()),
+        auth_headers("review-token-a"),
+        AxumPath(submission),
+        Json(TraceReviewDecisionRequest {
+            decision: TraceReviewDecision::Approve,
+            reason: Some(
+                "Synthetic Orbo preservation fixture reviewed locally; no reward claim".into(),
+            ),
+            credit_points_pending: None,
+        }),
+    )
+    .await
+    .unwrap();
+    let Json(delivered) = dataset_task_evidence_handler(
+        State(state.clone()),
+        auth_headers("review-token-a"),
+        Query(DatasetExportQuery {
+            limit: Some(1),
+            purpose: Some("orbo.attention_timing.v1".into()),
+            status: Some(TraceCorpusStatus::Accepted),
+            privacy_risk: Some(ResidualPiiRisk::Medium),
+            consent_scope: Some("debugging-evaluation".into()),
+        }),
+    )
+    .await
+    .unwrap();
+    assert_eq!(delivered.item_count, 1);
+    assert_eq!(
+        serde_json::to_value(&delivered.items[0].events).unwrap(),
+        expected
+    );
+    let output = std::path::PathBuf::from(env!("CARGO_MANIFEST_DIR"))
+        .join("../../target/orbo-delivered.json");
+    std::fs::create_dir_all(output.parent().unwrap()).unwrap();
+    std::fs::write(output, serde_json::to_vec_pretty(&delivered).unwrap()).unwrap();
+}
