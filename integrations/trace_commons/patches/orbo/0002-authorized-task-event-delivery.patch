+#[tokio::test]
+async fn orbo_task_evidence_requires_event_delivery() {
+    let temp = tempfile::tempdir().unwrap();
+    let state = test_state(temp.path().to_path_buf());
+    let mut envelope = low_risk_envelope().await;
+    envelope.consent.scopes = vec![ConsentScope::DebuggingEvaluation];
+    let submission_id = envelope.submission_id;
+    let expected_events = serde_json::to_value(&envelope.events).unwrap();
+    assert!(!envelope.events.is_empty());
+    let _ = test_submit(state.clone(), "token-a", envelope)
+        .await
+        .unwrap();
+    fn query() -> DatasetExportQuery {
+        DatasetExportQuery {
+            limit: Some(10),
+            purpose: Some("orbo_task_evidence_fixture".to_string()),
+            status: Some(TraceCorpusStatus::Accepted),
+            privacy_risk: Some(ResidualPiiRisk::Low),
+            consent_scope: Some("debugging-evaluation".to_string()),
+        }
+    }
+    let Json(legacy) = dataset_replay_handler(
+        State(state.clone()),
+        auth_headers("review-token-a"),
+        Query(query()),
+    )
+    .await
+    .unwrap();
+    assert!(
+        serde_json::to_value(legacy).unwrap()["items"][0]
+            .get("events")
+            .is_none(),
+        "legacy summary stays unchanged"
+    );
+    let Json(export) = dataset_task_evidence_handler(
+        State(state.clone()),
+        auth_headers("review-token-a"),
+        Query(query()),
+    )
+    .await
+    .unwrap();
+    assert_eq!(export.item_count, 1);
+    let encoded = serde_json::to_value(export).unwrap();
+    assert_eq!(encoded["items"][0]["events"], expected_events);
+    assert_eq!(
+        encoded["items"][0]["evidence_schema_version"],
+        "orbo.task-evidence.v1"
+    );
+    assert_eq!(
+        dataset_task_evidence_handler(
+            State(state.clone()),
+            auth_headers("token-a"),
+            Query(query())
+        )
+        .await
+        .unwrap_err()
+        .0,
+        StatusCode::FORBIDDEN
+    );
+    assert_eq!(
+        dataset_task_evidence_handler(
+            State(state.clone()),
+            auth_headers("review-token-a"),
+            Query(test_dataset_query())
+        )
+        .await
+        .unwrap_err()
+        .0,
+        StatusCode::BAD_REQUEST
+    );
+    let mut record = read_submission_record(temp.path(), "tenant-a", submission_id)
+        .unwrap()
+        .unwrap();
+    record.status = TraceCorpusStatus::Revoked;
+    write_submission_record(&state.root, &record).unwrap();
+    let Json(after) = dataset_task_evidence_handler(
+        State(state.clone()),
+        auth_headers("review-token-a"),
+        Query(query()),
+    )
+    .await
+    .unwrap();
+    assert_eq!(
+        after.item_count, 0,
+        "revoked evidence is not delivered again"
+    );
+    // The new surface must retain the server's rich-content/low-risk guardrail.
+    let guarded = test_state_with_export_guardrails(temp.path().join("guarded"));
+    let mut medium = query();
+    medium.privacy_risk = Some(ResidualPiiRisk::Medium);
+    assert_eq!(
+        dataset_task_evidence_handler(
+            State(guarded),
+            auth_headers("review-token-a"),
+            Query(medium)
+        )
+        .await
+        .unwrap_err()
+        .0,
+        StatusCode::BAD_REQUEST
+    );
+}
