+/// Opt-in event delivery for an explicit evaluation purpose, under the same
+/// exporter authentication, tenant policy, consent, risk and retention gates.
+/// Rich-content risk floors remain in force; this route never lowers them.
+async fn dataset_task_evidence_handler(
+    State(state): State<Arc<AppState>>,
+    headers: HeaderMap,
+    Query(mut query): Query<DatasetExportQuery>,
+) -> ApiResult<Json<TraceReplayDatasetExport>> {
+    let tenant = authenticate_with_tenant_access_grant(state.as_ref(), &headers).await?;
+    require_exporter(&tenant)?;
+    if query
+        .purpose
+        .as_deref()
+        .is_none_or(|p| p.trim().is_empty() || p.len() > 200)
+        || query.status != Some(TraceCorpusStatus::Accepted)
+        || !matches!(
+            query.privacy_risk,
+            Some(ResidualPiiRisk::Low | ResidualPiiRisk::Medium)
+        )
+        || parse_consent_scope_filter(query.consent_scope.as_deref())?
+            != Some(ConsentScope::DebuggingEvaluation)
+        || !(1..=10).contains(&query.limit.unwrap_or(1))
+    {
+        return Err(api_error(
+            StatusCode::BAD_REQUEST,
+            "explicit_bounded_task_evidence_scope_required",
+        ));
+    }
+    query.limit = Some(query.limit.unwrap_or(1));
+    let now = Utc::now();
+    let grant = create_one_shot_export_grant(
+        state.as_ref(),
+        &tenant,
+        TraceExportDatasetKind::ReplayDataset,
+        normalized_export_purpose(query.purpose.as_deref(), "orbo_task_evidence"),
+        query.limit,
+        now,
+    );
+    run_dataset_replay_export_with_events(state.as_ref(), &tenant, query, grant, now, true).await
+}
