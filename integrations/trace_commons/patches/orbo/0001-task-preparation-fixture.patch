+        let body = serde_json::to_vec_pretty(&prepared.events).unwrap();
+        assert!(
+            prepared
+                .events
+                .iter()
+                .any(|e| e.structured_payload["record_type"] == "trajectory_observation")
+        );
+        let output = std::path::PathBuf::from(env!("CARGO_MANIFEST_DIR"))
+            .join("../../target/orbo-prepared-events.json");
+        std::fs::create_dir_all(output.parent().unwrap()).unwrap();
+        std::fs::write(output, body).unwrap();
+    }
