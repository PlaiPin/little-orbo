+#[tokio::test]
+async fn orbo_targeted_evidence_selects_before_limit_and_keeps_policy() {
+    let temp = tempfile::tempdir().unwrap();
+    let state = test_state(temp.path().to_path_buf());
+    let mut ids = Vec::new();
+    for _ in 0..12 {
+        let mut envelope = low_risk_envelope().await;
+        envelope.consent.scopes = vec![ConsentScope::DebuggingEvaluation];
+        ids.push(envelope.submission_id);
+        let _ = test_submit(state.clone(), "token-a", envelope)
+            .await
+            .unwrap();
+    }
+    let query = |id: Uuid| TaskEvidenceQuery {
+        submission_ids: Some(id.to_string()),
+        scope: DatasetExportQuery {
+            limit: Some(1),
+            purpose: Some("orbo.attention_timing.v1".into()),
+            status: Some(TraceCorpusStatus::Accepted),
+            privacy_risk: Some(ResidualPiiRisk::Low),
+            consent_scope: Some("debugging-evaluation".into()),
+        },
+    };
+    use tower::ServiceExt;
+    let response = app(state.clone()).oneshot(axum::http::Request::builder()
+        .uri(format!("/v1/datasets/task-evidence?limit=1&purpose=orbo.attention_timing.v1&status=accepted&privacy_risk=low&consent_scope=debugging-evaluation&submission_ids={}", ids[11]))
+        .header("authorization", "Bearer review-token-a")
+        .body(axum::body::Body::empty()).unwrap()).await.unwrap();
+    assert_eq!(response.status(), StatusCode::OK);
+    assert_eq!(
+        response.headers()["x-orbo-task-selection"],
+        ids[11].to_string()
+    );
+    // Every one of twelve records is addressable with limit=1, regardless of ordering.
+    for id in &ids {
+        let (_, Json(result)) = dataset_task_evidence_handler(
+            State(state.clone()),
+            auth_headers("review-token-a"),
+            Query(query(*id)),
+        )
+        .await
+        .unwrap();
+        assert_eq!(result.item_count, 1);
+        assert_eq!(result.items[0].submission_id, *id);
+    }
+    let (_, Json(absent)) = dataset_task_evidence_handler(
+        State(state.clone()),
+        auth_headers("review-token-a"),
+        Query(query(Uuid::new_v4())),
+    )
+    .await
+    .unwrap();
+    assert_eq!(absent.item_count, 0);
+    // A foreign tenant cannot retrieve by guessing a known submission UUID.
+    let (_, Json(foreign)) = dataset_task_evidence_handler(
+        State(state.clone()),
+        auth_headers("review-token-b"),
+        Query(query(ids[0])),
+    )
+    .await
+    .unwrap();
+    assert_eq!(foreign.item_count, 0);
+    for bad in [
+        None,
+        Some("invalid".into()),
+        Some(format!("{},{}", ids[0], ids[0])),
+    ] {
+        let mut q = query(ids[0]);
+        q.submission_ids = bad;
+        assert_eq!(
+            dataset_task_evidence_handler(
+                State(state.clone()),
+                auth_headers("review-token-a"),
+                Query(q)
+            )
+            .await
+            .unwrap_err()
+            .0,
+            StatusCode::BAD_REQUEST
+        );
+    }
