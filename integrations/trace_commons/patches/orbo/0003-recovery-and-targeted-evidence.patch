+fn handle_orbo_revoke(shared: &DaemonShared, req: &Request) -> Response {
+    let Some(id) = req
+        .params
+        .get("entry_id")
+        .and_then(|v| v.as_str())
+        .and_then(|s| Uuid::parse_str(s).ok())
+    else {
+        return Response::err(req.id, ERR_BAD_PARAMS, "entry-id-required");
+    };
+    let mut queue = shared.queue.lock().expect("queue lock");
+    let before = queue.clone();
+    if !queue.orbo_revoke(id) {
+        return Response::err(req.id, ERR_BAD_PARAMS, "unknown-entry-id");
+    }
+    if queue.save(&shared.store).is_err() {
+        *queue = before;
+        return Response::err(req.id, ERR_UNAVAILABLE, "queue-write-failed");
+    }
+    let state = queue.get(id).unwrap().state;
+    Response::ok(
+        req.id,
+        serde_json::json!({"schema":"orbo.revocation.v1", "entry_id":id,
+        "fenced":true, "queue_state":state,
+        "upload_may_have_started":matches!(state, QueueState::Uploading | QueueState::Uploaded),
+        "already_delivered_copies_recalled":false}),
+    )
+}
