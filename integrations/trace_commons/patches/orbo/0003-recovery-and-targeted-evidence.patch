+fn handle_orbo_entry_status(shared: &DaemonShared, req: &Request) -> Response {
+    let Some(id) = req
+        .params
+        .get("entry_id")
+        .and_then(|v| v.as_str())
+        .and_then(|s| Uuid::parse_str(s).ok())
+    else {
+        return Response::err(req.id, ERR_BAD_PARAMS, "entry-id-required");
+    };
+    let Some(hash) = req
+        .params
+        .get("session_hash")
+        .and_then(|v| v.as_str())
+        .filter(|s| s.len() == 71 && s.starts_with("sha256:"))
+    else {
+        return Response::err(req.id, ERR_BAD_PARAMS, "source-hash-required");
+    };
+    let entry = {
+        let queue = shared.queue.lock().expect("queue lock");
+        match queue.get(id) {
+            Some(e) if e.session_hash != hash => {
+                return Response::err(req.id, ERR_BAD_PARAMS, "source-mismatch");
+            }
+            Some(e) => Some(
+                serde_json::json!({"state":e.state, "envelope_digest":e.previewed_envelope_digest,
+                                             "revoked":e.orbo_revoked}),
+            ),
+            None => None,
+        }
+    };
+    let Ok(records) = HistoryCache::load(&shared.store) else {
+        return Response::err(req.id, ERR_UNAVAILABLE, "history-read-failed");
+    };
+    let records: Vec<_> = records
+        .into_iter()
+        .filter(|r| r.session_hash == hash && !r.previous_account)
+        .collect();
+    let digest = format!(
+        "sha256:{:x}",
+        Sha256::digest(serde_json::to_vec(&records).unwrap())
+    );
+    if req
+        .params
+        .get("history_digest")
+        .and_then(|v| v.as_str())
+        .is_some_and(|v| v != digest)
+    {
+        return Response::err(req.id, ERR_BAD_PARAMS, "history-changed-restart-read");
+    }
+    let offset = req
+        .params
+        .get("offset")
+        .and_then(|v| v.as_u64())
+        .unwrap_or(0) as usize;
+    if offset > records.len() {
+        return Response::err(req.id, ERR_BAD_PARAMS, "invalid-offset");
+    }
+    let end = (offset + 100).min(records.len());
+    Response::ok(
+        req.id,
+        serde_json::json!({"schema":"orbo.entry-status.v1", "entry_id":id,
+        "session_hash":hash, "queue":entry, "history":&records[offset..end],
+        "history_digest":digest, "offset":offset, "next_offset":if end < records.len() { Some(end) } else { None }}),
     )
 }
 
