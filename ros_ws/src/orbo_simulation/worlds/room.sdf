<?xml version="1.0"?>
<sdf version="1.9">
  <world name="orbo_room">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor>
    </physics>
    <gravity>0 0 -9.81</gravity>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <scene><ambient>0.65 0.65 0.65 1</ambient><background>0.16 0.20 0.25 1</background><shadows>true</shadows></scene>
    <light name="sun" type="directional">
      <pose>0 0 5 0 0 0</pose><direction>-0.4 0.2 -1</direction>
      <diffuse>0.9 0.9 0.85 1</diffuse><specular>0.2 0.2 0.2 1</specular>
      <cast_shadows>true</cast_shadows>
    </light>
    <!-- 4 x 4 m interior. Low walls keep the first driving view unobstructed. -->
    <model name="room">
      <static>true</static>
      <link name="floor">
        <pose>0 0 -0.05 0 0 0</pose>
        <collision name="floor"><geometry><box><size>4.2 4.2 0.1</size></box></geometry></collision>
        <visual name="floor"><geometry><box><size>4.2 4.2 0.1</size></box></geometry>
          <material><ambient>0.65 0.62 0.54 1</ambient><diffuse>0.65 0.62 0.54 1</diffuse></material></visual>
      </link>
      <link name="north">
        <pose>0 2.05 0.25 0 0 0</pose>
        <collision name="wall"><geometry><box><size>4.2 0.1 0.5</size></box></geometry></collision>
        <visual name="wall"><geometry><box><size>4.2 0.1 0.5</size></box></geometry><material><diffuse>0.72 0.79 0.82 1</diffuse><ambient>0.72 0.79 0.82 1</ambient></material></visual>
      </link>
      <link name="south">
        <pose>0 -2.05 0.25 0 0 0</pose>
        <collision name="wall"><geometry><box><size>4.2 0.1 0.5</size></box></geometry></collision>
        <visual name="wall"><geometry><box><size>4.2 0.1 0.5</size></box></geometry><material><diffuse>0.72 0.79 0.82 1</diffuse><ambient>0.72 0.79 0.82 1</ambient></material></visual>
      </link>
      <link name="east">
        <pose>2.05 0 0.25 0 0 0</pose>
        <collision name="wall"><geometry><box><size>0.1 4 0.5</size></box></geometry></collision>
        <visual name="wall"><geometry><box><size>0.1 4 0.5</size></box></geometry><material><diffuse>0.72 0.79 0.82 1</diffuse><ambient>0.72 0.79 0.82 1</ambient></material></visual>
      </link>
      <link name="west">
        <pose>-2.05 0 0.25 0 0 0</pose>
        <collision name="wall"><geometry><box><size>0.1 4 0.5</size></box></geometry></collision>
        <visual name="wall"><geometry><box><size>0.1 4 0.5</size></box></geometry><material><diffuse>0.72 0.79 0.82 1</diffuse><ambient>0.72 0.79 0.82 1</ambient></material></visual>
      </link>
    </model>
    <model name="center_block">
      <static>true</static><pose>0.35 0.35 0.20 0 0 0</pose>
      <link name="body">
        <collision name="body"><geometry><box><size>0.5 0.5 0.4</size></box></geometry></collision>
        <visual name="body"><geometry><box><size>0.5 0.5 0.4</size></box></geometry><material><ambient>0.26 0.48 0.49 1</ambient><diffuse>0.26 0.48 0.49 1</diffuse></material></visual>
      </link>
    </model>
    <model name="side_block">
      <static>true</static><pose>-1.25 0.65 0.15 0 0 0.25</pose>
      <link name="body">
        <collision name="body"><geometry><box><size>0.35 0.65 0.3</size></box></geometry></collision>
        <visual name="body"><geometry><box><size>0.35 0.65 0.3</size></box></geometry><material><ambient>0.70 0.39 0.25 1</ambient><diffuse>0.70 0.39 0.25 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
