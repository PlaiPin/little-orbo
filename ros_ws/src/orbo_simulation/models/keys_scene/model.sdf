<sdf version="1.9">
  <model name="keys_scene">
    <static>true</static>
    <link name="keys">
      <pose>.24 1.03 .002 0 0 0</pose>
      <visual name="metal_keys">
        <geometry>
          <mesh>
            <uri>model://keys_scene/keys.obj</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>.72 .73 .76 1</ambient>
          <diffuse>.8 .81 .83 1</diffuse>
          <specular>1 1 1 1</specular>
          <shininess>90</shininess>
        </material>
      </visual>
      <visual name="blue_key_fob">
        <pose>-.015 -.038 .006 0 0 -.3</pose>
        <geometry>
          <box>
            <size>.028 .047 .007</size>
          </box>
        </geometry>
        <material>
          <ambient>.015 .15 .8 1</ambient>
          <diffuse>.015 .15 .8 1</diffuse>
        </material>
      </visual>
    </link>
    <link name="overview_camera">
      <pose>3 -3.5 3.3 0 .62 2.28</pose>
      <sensor name="overview" type="camera">
        <topic>/orbo_demo/overview</topic>
        <always_on>true</always_on>
        <update_rate>5</update_rate>
        <camera>
          <horizontal_fov>1.18</horizontal_fov>
          <image>
            <width>960</width>
            <height>640</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>.05</near>
            <far>20</far>
          </clip>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>
