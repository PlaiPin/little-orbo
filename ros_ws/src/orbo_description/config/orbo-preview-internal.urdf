<?xml version='1.0' encoding='utf-8'?>
<robot name="orbo_v9_internal">
  <link name="base_link" />
  <link name="cad_chassis_and_equipment">
    <visual>
      <geometry>
        <mesh filename="package://orbo_description/meshes/v9/chassis_and_equipment.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="chassis_and_equipment_material">
        <color rgba=".30 .43 .49 1" />
      </material>
    </visual>
  </link>
  <joint name="cad_chassis_and_equipment_mount" type="fixed">
    <parent link="base_link" />
    <child link="cad_chassis_and_equipment" />
  </joint>
  <link name="cad_display_module">
    <visual>
      <geometry>
        <mesh filename="package://orbo_description/meshes/v9/display_module.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="display_module_material">
        <color rgba=".15 .2 .2 1" />
      </material>
    </visual>
  </link>
  <joint name="cad_display_module_mount" type="fixed">
    <parent link="base_link" />
    <child link="cad_display_module" />
  </joint>
  <link name="cad_display_mount">
    <visual>
      <geometry>
        <mesh filename="package://orbo_description/meshes/v9/display_mount.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="display_mount_material">
        <color rgba=".30 .43 .49 1" />
      </material>
    </visual>
  </link>
  <joint name="cad_display_mount_mount" type="fixed">
    <parent link="base_link" />
    <child link="cad_display_mount" />
  </joint>
  <link name="cad_flipper_covers">
    <visual>
      <geometry>
        <mesh filename="package://orbo_description/meshes/v9/flipper_covers.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="flipper_covers_material">
        <color rgba=".95 .56 .37 1" />
      </material>
    </visual>
  </link>
  <joint name="cad_flipper_covers_mount" type="fixed">
    <parent link="base_link" />
    <child link="cad_flipper_covers" />
  </joint>
  <link name="cad_left_wheel">
    <visual>
      <geometry>
        <mesh filename="package://orbo_description/meshes/v9/left_wheel.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="left_wheel_material">
        <color rgba=".1 .1 .1 1" />
      </material>
    </visual>
  </link>
  <joint name="cad_left_wheel_mount" type="fixed">
    <parent link="base_link" />
    <child link="cad_left_wheel" />
    <origin xyz="0 0.0509 0" />
  </joint>
  <link name="cad_right_wheel">
    <visual>
      <geometry>
        <mesh filename="package://orbo_description/meshes/v9/right_wheel.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="right_wheel_material">
        <color rgba=".1 .1 .1 1" />
      </material>
    </visual>
  </link>
  <joint name="cad_right_wheel_mount" type="fixed">
    <parent link="base_link" />
    <child link="cad_right_wheel" />
    <origin xyz="0 -0.0509 0" />
  </joint>
  <link name="cad_servos">
    <visual>
      <geometry>
        <mesh filename="package://orbo_description/meshes/v9/servos.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="servos_material">
        <color rgba=".30 .43 .49 1" />
      </material>
    </visual>
  </link>
  <joint name="cad_servos_mount" type="fixed">
    <parent link="base_link" />
    <child link="cad_servos" />
  </joint>
</robot>