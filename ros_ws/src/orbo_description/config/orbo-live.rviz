Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: [/Global Options1, /Status1, /Orbo CAD meshes1]
      Splitter Ratio: 0.55
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (5 cm)
      Enabled: true
      Value: true
      Cell Size: 0.05
      Plane Cell Count: 12
      Color: 105; 115; 130
      Alpha: 0.4
      Line Style:
        Value: Lines
        Line Width: 0.001
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/RobotModel
      Name: Orbo CAD meshes
      Enabled: true
      Value: true
      Alpha: 1
      Visual Enabled: true
      Collision Enabled: false
      Description Source: Topic
      Description Topic:
        Value: /orbo/robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/Odometry
      Name: Measured wheel odometry
      Enabled: true
      Topic:
        Value: /orbo/drive_controller/odom
        Reliability Policy: Best Effort
      Shape: Arrow
      Shaft Length: 0.025
      Shaft Radius: 0.002
      Head Length: 0.008
      Head Radius: 0.004
      Keep: 100
      Position Tolerance: 0.005
      Angle Tolerance: 0.05
  Enabled: true
  Global Options:
    Background Color: 35; 40; 49
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 0.65
      Focal Point: {X: 0, Y: 0, Z: 0.125}
      Near Clip Distance: 0.005
      Pitch: 0.15
      Yaw: 5.54
      Target Frame: <Fixed Frame>
Window Geometry:
  Width: 1200
  Height: 800
  X: 60
  Y: 60
  Hide Left Dock: false
  Hide Right Dock: true
