<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="orbo">
  <xacro:arg name="calibration" default="/etc/orbo/calibration.yaml"/>
  <xacro:property name="c" value="${xacro.load_yaml('$(arg calibration)')}"/>
  <xacro:include filename="$(find orbo_description)/config/cad-v9.xacro"/>
  <link name="base_link"><collision><geometry><box size="${c['base_length']} ${c['base_width']} ${c['base_height']}"/></geometry></collision></link>
  <xacro:orbo_cad/>
  <xacro:macro name="wheel" params="side sign">
    <link name="${side}_wheel">
      <xacro:if value="${side == 'left'}"><xacro:cad_left_wheel/></xacro:if>
      <xacro:if value="${side == 'right'}"><xacro:cad_right_wheel/></xacro:if>
    </link>
    <joint name="${side}_wheel_joint" type="continuous"><parent link="base_link"/><child link="${side}_wheel"/><origin xyz="0 ${sign*c['wheel_separation']/2} 0"/><axis xyz="0 1 0"/></joint>
  </xacro:macro>
  <xacro:wheel side="left" sign="1"/><xacro:wheel side="right" sign="-1"/>
  <ros2_control name="OrboWheels" type="system">
    <hardware><plugin>orbo_hardware/System</plugin><param name="calibrated">true</param><param name="max_velocity_rad_s">${c['max_wheel_rad_s']}</param></hardware>
    <joint name="left_wheel_joint"><command_interface name="velocity"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="right_wheel_joint"><command_interface name="velocity"/><state_interface name="position"/><state_interface name="velocity"/></joint>
  </ros2_control>
</robot>
