# Copy this file to ../orbo-local/credentials.env from the little-orbo root.
# Or run: uv run --frozen orbo credentials init
# Edit the external copy only. Leave unused values blank.
# Literal KEY=value syntax; optional quotes, no interpolation or shell sourcing.

# Required for NEAR reasoning/vision and GPT-Live tests.
NEARAI_API_KEY=""
OPENAI_API_KEY=""

# Trace Commons: retrieval and the privacy classifier.
COMMONS_EXPORT_TOKEN=""
TRACE_NEAR_AI_PRIVACY_API_KEY=""

# Trace Commons enrollment: use the method supplied by your operator.
TRACE_COMMONS_INVITE=""
TRACE_COMMONS_DEVICE_CODE=""

# Only for self-hosted Commons database access.
DATABASE_URL=""
TRACE_COMMONS_LOGIN_RESOLVER_DATABASE_URL=""

# Optional authoritative accounting.
COMMONS_CONTRIBUTOR_TOKEN=""
NEARAI_REPORTING_TOKEN=""

# Optional Intents partner API key; quotes also support unauthenticated access.
NEAR_INTENTS_API_KEY=""

# Only for explicitly approved funded swaps. Use a dedicated NEAR account.
# Public/private keys use standard ed25519: encodings.
NEAR_SIGNER_ACCOUNT_ID=""
NEAR_SIGNER_PUBLIC_KEY=""
NEAR_SIGNER_PRIVATE_KEY=""

# Optional private remote-task gateway.
ORBO_REMOTE_OWNER_PHONE_TOKEN=""

# Optional alternate Fish voice flow; unnecessary for GPT-Live.
FISH_API_KEY=""
FISH_VOICE_ID=""
