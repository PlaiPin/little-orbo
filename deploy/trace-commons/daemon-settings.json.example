{
  "schema_version": "trace_commons.daemon_settings.v1",
  "poll_interval_secs": 60,
  "quiescence_secs": 30,
  "digest_interval_secs": 14400,
  "queue_ttl_days": 14,
  "growth_factor": 2.0,
  "growth_min_new_bytes": 65536,
  "max_reuploads": 3,
  "max_queue_entries": 500,
  "history_poll_secs": 1800,
  "canary_interval_secs": 3600,
  "approval_hold_secs": 10,
  "local_notifications": false,
  "claude_source": {"mode": "off"},
  "codex_source": {"mode": "off"},
  "gemini_source": {"mode": "off"},
  "cline_source": {"mode": "off"},
  "opencode_source": {"mode": "off"},
  "trajectory_source": {"mode": "off"},
  "ironwire": {"mode": "off"},
  "private_inference": false,
  "share_usage_data": false,
  "subscription_usage_codex_enabled": false,
  "subscription_usage_claude_enabled": false,
  "suggestions_enabled": false,
  "settlement_estimate_enabled": false
}
