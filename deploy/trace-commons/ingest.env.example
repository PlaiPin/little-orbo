# Server-only credentials. Fill on the host; never put real values in Git.
TRACE_COMMONS_BIND=127.0.0.1:3907
TRACE_COMMONS_DATA_DIR=/var/lib/trace-commons
RUST_LOG=warn

# Configure the operator's managed EdDSA issuer and PostgreSQL tenant grants.
TRACE_COMMONS_REQUIRE_EDDSA_SIGNED_TOKENS=true
TRACE_COMMONS_REQUIRE_MANAGED_EDDSA_SIGNED_TOKENS=true
TRACE_COMMONS_SIGNED_TOKEN_EDDSA_KEYSET_URL=https://REPLACE_ISSUER/.well-known/keyset
TRACE_COMMONS_SIGNED_TOKEN_EDDSA_KEYSET_URL_ALLOWED_HOSTS=REPLACE_ISSUER
TRACE_COMMONS_SIGNED_TOKEN_ISSUER=https://REPLACE_ISSUER
TRACE_COMMONS_SIGNED_TOKEN_AUDIENCE=trace-commons-ingest
TRACE_COMMONS_SIGNED_TOKEN_REQUIRE_JTI=true
TRACE_COMMONS_REQUIRE_TENANT_ACCESS_GRANTS=true
TRACE_COMMONS_DB_DUAL_WRITE=true
TRACE_COMMONS_REQUIRE_POSTGRES_TRACE_RLS_READY=true
TRACE_COMMONS_REQUIRE_DB_RECONCILIATION_CLEAN=true
DATABASE_URL=REPLACE_POSTGRES_RUNTIME_URL
# Login resolver role, migrations, tenant policy/grants and issuer enrollment
# are provisioned by your instance operator, not by the Orbo robot runtime.
TRACE_COMMONS_LOGIN_RESOLVER_DATABASE_URL=REPLACE_POSTGRES_LOGIN_RESOLVER_URL

# Do not accept private traces without a configured upstream privacy filter.
TRACE_COMMONS_REQUIRE_PRIVACY_FILTER=true
TRACE_PRIVACY_FILTER_BACKEND=near-ai
TRACE_NEAR_AI_PRIVACY_API_KEY=REPLACE_PRIVACY_CLASSIFIER_API_KEY
TRACE_NEAR_AI_PRIVACY_BASE_URL=https://cloud-api.near.ai/v1
TRACE_NEAR_AI_PRIVACY_MODEL=openai/privacy-filter
TRACE_NEAR_AI_PRIVACY_TIMEOUT_MS=15000
TRACE_NEAR_AI_PRIVACY_TIMEOUT_PER_KIB_MS=600
TRACE_NEAR_AI_PRIVACY_MAX_REQUEST_BODY_BYTES=65536
TRACE_NEAR_AI_PRIVACY_MAX_BATCH_INPUTS=1
# This template intentionally fails startup until these dependencies exist.
