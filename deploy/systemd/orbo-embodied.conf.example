# Install explicitly as /etc/systemd/system/orbo-runtime.service.d/embodied.conf
# after copying the owner-edited profile and owner-only credentials. Not auto-installed.
[Service]
ExecStart=
ExecStart=/opt/orbo/deploy/run-runtime.sh /etc/orbo/embodied.toml
# Local motion is stopped first; allow bounded provider/Live finalization afterward.
TimeoutStopSec=150
Environment=ORBO_CREDENTIALS_CONFIG=/opt/orbo/deploy/credentials.service.toml
LoadCredential=orbo.env:/etc/orbo/credentials.env
